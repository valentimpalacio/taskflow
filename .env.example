# Environment variables
# Copy this file to .env.local and fill in the values

# NextAuth.js configuration
# On Vercel, set NEXTAUTH_URL to your production URL
NEXTAUTH_URL=http://localhost:3000
# On Vercel, set NEXTAUTH_SECRET to a strong random string (openssl rand -base64 32)
NEXTAUTH_SECRET=your-super-secret-key-change-in-production

# Google OAuth (optional, for Google Sign-in)
# Get these from https://console.developers.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Database (Neon Postgres recommended for Vercel)
DATABASE_URL="postgresql://user:password@localhost:5432/taskflow?schema=public"